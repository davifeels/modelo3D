# ─────────────────────────────────────────────────────────────────────────────
# Copie para .env  (cp .env.example .env)  e preencha com valores REAIS.
# O .env é ignorado pelo git — segredos NUNCA vão para o repositório.
# Em produção, gere segredos fortes e troque a senha do admin.
# ─────────────────────────────────────────────────────────────────────────────

# Banco de dados
POSTGRES_PASSWORD=troque-esta-senha-do-postgres

# Assinatura dos tokens JWT — gere com:  openssl rand -hex 32
JWT_SECRET=troque-por-um-hex-de-32-bytes-aleatorio

# Segredo do webhook do gateway de pagamento (X-Webhook-Secret)
WEBHOOK_SECRET=troque-por-um-segredo-aleatorio

# Conta do dono (painel /admin + cliente Pro). Troque a senha!
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=troque-esta-senha-do-admin

# URL pública do frontend (link nos e-mails e origem permitida no CORS)
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ── Domínio (produção com Caddy/HTTPS) ──
# Seu domínio sem http/www. O Caddy emite HTTPS para @, www, app e admin.
# Em produção, APP_URL/ALLOWED_ORIGINS/MP_WEBHOOK_URL são derivados daqui pelo
# docker-compose.prod.yml — não precisa setá-los à mão.
DOMAIN=seudominio.com.br
ACME_EMAIL=seu-email@exemplo.com

# ── Gateway de pagamento (Mercado Pago) ──
# PAYMENT_GATEWAY=mercadopago  e  MP_ACCESS_TOKEN=APP_USR-...  (access token do
# vendedor). MP_WEBHOOK_SECRET (painel MP → Webhooks) é opcional mas recomendado.
PAYMENT_GATEWAY=none
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# E-mail real (opcional): sem SMTP_HOST os envios são SIMULADOS
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=...
# SMTP_FROM=no-reply@seudominio.com
